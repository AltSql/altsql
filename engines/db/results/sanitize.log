for t in test_db test_rows test_sync test_sql test_same test_savepoint test_index test_crash test_fault; do \
  cc -std=c99 -pedantic -Wall -Wextra -Wshadow -D_POSIX_C_SOURCE=200809L -O1 -g -fsanitize=address,undefined,float-cast-overflow -fno-omit-frame-pointer -fno-sanitize-recover=all -I../../core/dist -I. -Itests -o build/$t.san tests/$t.c -lm && ./build/$t.san quick || exit 1; \
done
